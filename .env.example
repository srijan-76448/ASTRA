# ==========================================
# ANGEL ONE SMARTAPI CREDENTIALS
# ==========================================
# IMPORTANT:
# Use newly rotated credentials here.
# Never commit this file to Git.
ANGEL_API_KEY=your_angel_one_api_key
ANGEL_CLIENT_CODE=your_client_code
ANGEL_PIN=your_account_pin
ANGEL_TOTP_SECRET=your_base32_totp_secret

# ==========================================
# TELEGRAM BOT CONFIGURATION
# ==========================================
# Use the newly regenerated bot token.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Your Telegram chat ID
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ==========================================
# GOOGLE CLOUD SERVICE ACCOUNT & SHEETS
# ==========================================
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ==========================================
# SMTP MAILER SETTINGS
# ==========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_passcode
SMTP_RECEIVER_EMAIL=your_email@gmail.com

# ==================================================
# ANGEL ONE API PROTECTION / RATE LIMITING
# ==================================================
# Minimum cooldown between authentication retries
ANGEL_AUTH_RETRY_COOLDOWN=60
# Wallet cache lifetime in seconds
ANGEL_WALLET_CACHE_TTL=30
# Wallet retry cooldown in seconds
ANGEL_WALLET_RETRY_COOLDOWN=15
# Minimum spacing between wallet refresh requests
ANGEL_WALLET_REFRESH_SPACING=1.10

# ==================================================
# Telegram Bot Settings
# ==================================================
TELEGRAM_PASSWORD=your_telegram_password
